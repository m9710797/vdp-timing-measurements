10 BLOAD"name.com"
20 POKE&HC000,5:  ' mode
30 POKE&HC001,3:  ' enable
40 POKE&HC002,2:  ' sprite
45 POKE&HC00C,100:  ' num accesses (low)
46 POKE&HC00D,0:    '              (high)
47 POKE&HC00E,0:    ' access type (0 = read, 1 = write)
50 GOSUB275
60 DEFUSR=&HC200:A=USR(0)
70 A$=INPUT$(1)
80 SCREEN0
90 END
100 ' poke command bytes
110 POKE&HC010,SXAND255
120 POKE&HC011,SX\255
130 POKE&HC012,SYAND255
140 POKE&HC013,SY\255
150 POKE&HC014,DXAND255
160 POKE&HC015,DX\255
170 POKE&HC016,DYAND255
180 POKE&HC017,DY\255
190 POKE&HC018,NXAND255
200 POKE&HC019,NX\255
210 POKE&HC01A,NYAND255
220 POKE&HC01B,NY\255
230 POKE&HC01C,CO
240 POKE&HC01D,AR
250 POKE&HC01E,CM
260 RETURN
275 SX=0:SY=768:DX=0:DY=896:NX=256:NY=128:CO=255:AR=0:CM=&HC0:GOSUB100:RETURN
276 SX=0:SY=768:DX=0:DY=896:NX=512:NY=128:CO=255:AR=0:CM=&HC0:GOSUB100:RETURN
277 SX=0:SY=384:DX=0:DY=448:NX=512:NY= 64:CO=255:AR=0:CM=&HC0:GOSUB100:RETURN
278 SX=0:SY=384:DX=0:DY=448:NX=256:NY= 64:CO=255:AR=0:CM=&HC0:GOSUB100:RETURN
